{
  "name": "senangstart-xr",
  "version": "2.1.0",
  "description": "SenangStart XR - 3D GUI components for A-Frame / WebXR",
  "author": "SenangStart XR",
  "license": "MIT",
  "main": "dist/senangstart-xr.min.js",
  "exports": {
    ".": "./dist/senangstart-xr.min.js",
    "./src/*": "./src/*"
  },
  "unpkg": "dist/senangstart-xr.min.js",
  "jsdelivr": "dist/senangstart-xr.min.js",
  "files": [
    "dist",
    "src",
    "Outfit-Regular.ttf",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookklik-technologies/senangstart-xr.git"
  },
  "bugs": {
    "url": "https://github.com/bookklik-technologies/senangstart-xr/issues"
  },
  "homepage": "https://github.com/bookklik-technologies/senangstart-xr#readme",
  "scripts": {
    "dist": "webpack && webpack --env mode=development",
    "dist-min": "webpack --env mode=production",
    "dist-dev": "webpack --env mode=development",
    "dist-example": "webpack --env output=example mode=development",
    "dist-example-min": "webpack --env output=example mode=production",
    "dist:all": "npm run dist && npm run dist-example && npm run dist-example-min",
    "check:build": "node scripts/check-build.js",
    "check:package": "node scripts/verify-package.js",
    "check:browser": "node scripts/browser-check.js",
    "start": "webpack serve",
    "lint": "eslint src/ tests/ scripts/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "test": "jest",
    "audit:prod": "npm audit --omit=dev --omit=peer",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "aframe",
    "a-frame",
    "aframe-component",
    "webxr",
    "vr",
    "webgl",
    "gui",
    "3d-ui",
    "senangstart-xr"
  ],
  "peerDependencies": {
    "aframe": ">=1.7.0 <1.9.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@eslint/js": "^9.0.0",
    "ajv": "^8.0.0",
    "babel-loader": "^10.1.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.0.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.0.0",
    "prettier": "^3.0.0",
    "terser-webpack-plugin": "^5.3.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.4"
  },
  "dependencies": {
    "@bookklik/senangstart-icons": "^1.0.14"
  }
}
