{
  "name": "senangstart-xr",
  "version": "1.0.0",
  "description": "SenangStart XR - 3D GUI components for A-Frame / WebXR",
  "author": "SenangStart XR",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "dist": "webpack",
    "dist-min": "webpack --env mode=production",
    "dist-example": "webpack --env output=example",
    "dist-example-min": "webpack --env output=example mode=production",
    "start": "webpack serve",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "jest",
    "audit:prod": "npm audit --omit=dev --omit=peer",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "aframe",
    "a-frame",
    "aframe-component",
    "webxr",
    "vr",
    "webgl",
    "gui",
    "3d-ui",
    "senangstart-xr"
  ],
  "peerDependencies": {
    "aframe": ">=1.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@eslint/js": "^9.0.0",
    "ajv": "^8.0.0",
    "babel-loader": "^10.1.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.0.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.0.0",
    "prettier": "^3.0.0",
    "terser-webpack-plugin": "^5.3.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.4"
  },
  "dependencies": {
    "@bookklik/senangstart-icons": "^1.0.14"
  }
}
